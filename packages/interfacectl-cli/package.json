{
  "name": "@surfaces/interfacectl-cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.20.0 || >=20.10.0"
  },
  "bin": {
    "interfacectl": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:deps": "pnpm --filter @surfaces/interfacectl-validator run build && pnpm --filter @surfaces/interfacectl-extractor run build",
    "build": "pnpm run build:deps && pnpm run clean && tsc -p tsconfig.json && pnpm run fix-bin-permissions",
    "clean": "rm -rf dist",
    "fix-bin-permissions": "chmod +x dist/index.js",
    "validate": "node dist/index.js validate --root test/fixtures/minimal-project --contract test/fixtures/minimal-project/contracts/ui.contract.json",
    "test": "node --test test/index.mjs"
  },
  "dependencies": {
    "@surfaces/interfacectl-extractor": "^0.1.0",
    "@surfaces/interfacectl-validator": "^0.1.0",
    "commander": "^12.1.0",
    "globby": "^14.0.2",
    "picocolors": "^1.0.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.6.3"
  }
}
