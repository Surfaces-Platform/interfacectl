{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.dev/schemas/generation-session-comparison.schema.json",
  "title": "GenerationSessionComparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surfaceId", "tool", "brief", "baseline", "guided", "delta", "heuristics", "checks", "paths"],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "surfaceId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "enum": ["codex", "cursor", "local-llm"]
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "baselinePath", "guidedPath"],
      "properties": {
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "baselinePath": {
          "type": "string",
          "minLength": 1
        },
        "guidedPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/sessionSnapshot"
    },
    "guided": {
      "$ref": "#/$defs/sessionSnapshot"
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstAttemptVerdict", "firstAttemptFindingCountDelta", "firstAttemptBlockingFindingCountDelta", "firstAttemptWarningFindingCountDelta", "latestFindingCountDelta", "attemptsToAcceptableOutcome", "rubric"],
      "properties": {
        "firstAttemptVerdict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "guided"],
          "properties": {
            "baseline": {
              "type": "string",
              "enum": ["pass", "accepted-warn", "warn", "block"]
            },
            "guided": {
              "type": "string",
              "enum": ["pass", "accepted-warn", "warn", "block"]
            }
          }
        },
        "firstAttemptFindingCountDelta": {
          "type": "number"
        },
        "firstAttemptBlockingFindingCountDelta": {
          "type": "number"
        },
        "firstAttemptWarningFindingCountDelta": {
          "type": "number"
        },
        "latestFindingCountDelta": {
          "type": "number"
        },
        "attemptsToAcceptableOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "guided", "delta"],
          "properties": {
            "baseline": {
              "type": ["number", "null"]
            },
            "guided": {
              "type": ["number", "null"]
            },
            "delta": {
              "type": ["number", "null"]
            }
          }
        },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure", "components", "boundary", "visual", "responsiveness"],
          "properties": {
            "structure": {
              "$ref": "#/$defs/rubricDelta"
            },
            "components": {
              "$ref": "#/$defs/rubricDelta"
            },
            "boundary": {
              "$ref": "#/$defs/rubricDelta"
            },
            "visual": {
              "$ref": "#/$defs/rubricDelta"
            },
            "responsiveness": {
              "$ref": "#/$defs/rubricDelta"
            }
          }
        }
      }
    },
    "heuristics": {
      "$ref": "#/$defs/comparisonHeuristics"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidedFewerFirstAttemptBlockingFindings", "guidedReachedAcceptableNoLater", "guidedRubricAtLeastAsGood", "guidedRubricBetterDimensions", "meetsGoal"],
      "properties": {
        "guidedFewerFirstAttemptBlockingFindings": {
          "type": "boolean"
        },
        "guidedReachedAcceptableNoLater": {
          "type": "boolean"
        },
        "guidedRubricAtLeastAsGood": {
          "type": "boolean"
        },
        "guidedRubricBetterDimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["structure", "components", "boundary", "visual", "responsiveness"]
          }
        },
        "meetsGoal": {
          "type": "boolean"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineSessionDir", "guidedSessionDir"],
      "properties": {
        "baselineSessionDir": {
          "type": "string",
          "minLength": 1
        },
        "guidedSessionDir": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "assessmentHeuristics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unresolvedAcceptedSuggestionCount": {
          "type": "number",
          "minimum": 0
        },
        "unresolvedAcceptedSuggestionRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "noChangesAfterEditFailureCount": {
          "type": "number",
          "minimum": 0
        },
        "recoverableToolErrorCount": {
          "type": "number",
          "minimum": 0
        },
        "touchedFilesPerResolvedFinding": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "sessionHeuristics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latestAttempt", "repeatedFindingCarryoverCount", "rerunsToAcceptableOutcome"],
      "properties": {
        "latestAttempt": {
          "$ref": "#/$defs/assessmentHeuristics"
        },
        "repeatedFindingCarryoverCount": {
          "type": "number",
          "minimum": 0
        },
        "rerunsToAcceptableOutcome": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "comparisonHeuristics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "guided", "delta"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/sessionHeuristics"
        },
        "guided": {
          "$ref": "#/$defs/sessionHeuristics"
        },
        "delta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unresolvedAcceptedSuggestionRate",
            "noChangesAfterEditFailureCount",
            "recoverableToolErrorCount",
            "touchedFilesPerResolvedFinding",
            "repeatedFindingCarryoverCount",
            "rerunsToAcceptableOutcome"
          ],
          "properties": {
            "unresolvedAcceptedSuggestionRate": {
              "type": ["number", "null"]
            },
            "noChangesAfterEditFailureCount": {
              "type": "number"
            },
            "recoverableToolErrorCount": {
              "type": "number"
            },
            "touchedFilesPerResolvedFinding": {
              "type": ["number", "null"]
            },
            "repeatedFindingCarryoverCount": {
              "type": "number"
            },
            "rerunsToAcceptableOutcome": {
              "type": ["number", "null"]
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "components", "boundary", "visual", "responsiveness", "notes"],
      "properties": {
        "structure": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "components": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "boundary": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "visual": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "responsiveness": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "touchedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "heuristics": {
          "$ref": "#/$defs/assessmentHeuristics"
        }
      }
    },
    "attemptSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptNumber", "status", "outcome", "findingCount", "blockingFindingCount", "warningFindingCount", "findingCodes", "assessment"],
      "properties": {
        "attemptNumber": {
          "type": "number",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "block"]
        },
        "outcome": {
          "type": "string",
          "enum": ["pass", "accepted-warn", "warn", "block"]
        },
        "findingCount": {
          "type": "number",
          "minimum": 0
        },
        "blockingFindingCount": {
          "type": "number",
          "minimum": 0
        },
        "warningFindingCount": {
          "type": "number",
          "minimum": 0
        },
        "findingCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "preview": {
          "$ref": "#/$defs/previewRef"
        }
      }
    },
    "sessionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "sessionDir", "guidanceStrategy", "attemptCount", "firstAcceptableAttempt", "latestOutcome", "firstAttempt", "latestAttempt", "recurringFindingCodes", "recurringRepairCodes", "heuristics"],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "sessionDir": {
          "type": "string",
          "minLength": 1
        },
        "guidanceStrategy": {
          "type": "string",
          "enum": ["prompt-summary", "json-primary", "unguided"]
        },
        "attemptCount": {
          "type": "number",
          "minimum": 1
        },
        "firstAcceptableAttempt": {
          "type": ["number", "null"]
        },
        "latestOutcome": {
          "type": "string",
          "enum": ["pass", "accepted-warn", "warn", "block"]
        },
        "firstAttempt": {
          "$ref": "#/$defs/attemptSnapshot"
        },
        "latestAttempt": {
          "$ref": "#/$defs/attemptSnapshot"
        },
        "recurringFindingCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recurringCount"
          }
        },
        "recurringRepairCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recurringRepair"
          }
        },
        "heuristics": {
          "$ref": "#/$defs/sessionHeuristics"
        }
      }
    },
    "recurringCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "number",
          "minimum": 2
        }
      }
    },
    "recurringRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count", "priority", "category", "actionType"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "number",
          "minimum": 2
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "actionType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rubricDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "guided", "delta"],
      "properties": {
        "baseline": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "guided": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "delta": {
          "type": "number"
        }
      }
    },
    "previewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePath", "metadataPath", "url", "finalUrl", "capturedAt"],
      "properties": {
        "imagePath": {
          "type": "string",
          "minLength": 1
        },
        "metadataPath": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "finalUrl": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "waitFor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
