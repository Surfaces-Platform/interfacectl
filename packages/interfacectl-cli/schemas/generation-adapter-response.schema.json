{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.dev/schemas/generation-adapter-response.schema.json",
  "title": "GenerationAdapterResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "status", "surfaceId", "bundle", "contract", "coverage", "findings", "timings", "provenance"],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "warn", "block"]
    },
    "surfaceId": {
      "type": "string",
      "minLength": 1
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "version", "manifestPath", "surfacePath"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "surfacePath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationGuard", "fullValidate", "shellBoundaryEvaluated", "colorPolicyEvaluated", "iconPolicyEvaluated"],
      "properties": {
        "generationGuard": { "type": "boolean" },
        "fullValidate": { "type": "boolean" },
        "shellBoundaryEvaluated": { "type": "boolean" },
        "colorPolicyEvaluated": { "type": "boolean" },
        "iconPolicyEvaluated": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "policy", "message", "location", "evidence"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "policy": { "type": "string", "enum": ["strict", "warn", "off"] },
          "message": { "type": "string", "minLength": 1 },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 0 }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalMs"],
      "properties": {
        "totalMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "evaluatedAt"],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
