{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.dev/schemas/generation-assessment.schema.json",
  "title": "GenerationAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["structure", "components", "boundary", "visual", "responsiveness", "notes"],
  "properties": {
    "structure": {
      "type": "string",
      "enum": ["strong", "partial", "weak"]
    },
    "components": {
      "type": "string",
      "enum": ["strong", "partial", "weak"]
    },
    "boundary": {
      "type": "string",
      "enum": ["strong", "partial", "weak"]
    },
    "visual": {
      "type": "string",
      "enum": ["strong", "partial", "weak"]
    },
    "responsiveness": {
      "type": "string",
      "enum": ["strong", "partial", "weak"]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "touchedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
