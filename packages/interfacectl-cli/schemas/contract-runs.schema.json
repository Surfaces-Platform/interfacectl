{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.dev/schemas/contract-runs.schema.json",
  "title": "ContractRunsDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runs"],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "workspaceId",
          "ingestedAt",
          "createdAt",
          "surfaceId",
          "source",
          "contract",
          "artifacts",
          "status",
          "findingCodes",
          "summary"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "ingestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "surfaceId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["bootstrap", "generation", "ci", "runtime"]
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "sha256"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extractionPath": {
                "type": "string",
                "minLength": 1
              },
              "reportPath": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "fail", "unknown"]
          },
          "findingCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["errorCount", "warnCount"],
            "properties": {
              "errorCount": {
                "type": "number",
                "minimum": 0
              },
              "warnCount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
