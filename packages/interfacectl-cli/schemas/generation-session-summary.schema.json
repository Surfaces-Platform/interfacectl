{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaces.dev/schemas/generation-session-summary.schema.json",
  "title": "GenerationSessionSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surfaceId",
    "sessionId",
    "tool",
    "guidanceStrategy",
    "attemptCount",
    "firstPassAttempt",
    "firstAcceptableAttempt",
    "latestStatus",
    "latestOutcome",
    "recurringFindingCodes",
    "recurringRepairCodes",
    "latestAssessment",
    "latestReview",
    "heuristics",
    "successRule",
    "paths",
    "attempts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 4
    },
    "surfaceId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "enum": ["codex", "cursor", "local-llm"]
    },
    "guidanceStrategy": {
      "type": "string",
      "enum": ["prompt-summary", "json-primary", "unguided"]
    },
    "attemptCount": {
      "type": "number",
      "minimum": 1
    },
    "firstPassAttempt": {
      "type": ["number", "null"]
    },
    "firstAcceptableAttempt": {
      "type": ["number", "null"]
    },
    "latestStatus": {
      "type": "string",
      "enum": ["pass", "warn", "block"]
    },
    "latestOutcome": {
      "type": "string",
      "enum": ["pass", "accepted-warn", "warn", "block"]
    },
    "recurringFindingCodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurringCount"
      }
    },
    "recurringRepairCodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurringRepair"
      }
    },
    "latestAssessment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/assessment"
        }
      ]
    },
    "latestReview": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review"
        }
      ]
    },
    "heuristics": {
      "$ref": "#/$defs/sessionHeuristics"
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "successRule": {
      "$ref": "#/$defs/successRule"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionPath", "bundleRoot", "preparedInputPath", "guidanceHandoffPath"],
      "properties": {
        "sessionPath": {
          "type": "string",
          "minLength": 1
        },
        "bundleRoot": {
          "type": "string",
          "minLength": 1
        },
        "preparedInputPath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "guidanceHandoffPath": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptNumber",
          "status",
          "outcome",
          "findingCodes",
          "validatePath",
          "assessmentPath",
          "metadataPath"
        ],
        "properties": {
          "attemptNumber": {
            "type": "number",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "block"]
          },
          "outcome": {
            "type": "string",
            "enum": ["pass", "accepted-warn", "warn", "block"]
          },
          "findingCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validatePath": {
            "type": "string",
            "minLength": 1
          },
          "assessmentPath": {
            "type": "string",
            "minLength": 1
          },
          "metadataPath": {
            "type": "string",
            "minLength": 1
          },
          "reviewPath": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "type": "string",
            "enum": ["accepted", "rejected"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "preview": {
            "$ref": "#/$defs/previewRef"
          }
        }
      }
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "successRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalStatus"],
      "properties": {
        "finalStatus": {
          "type": "string",
          "const": "pass-or-reviewed-warn"
        }
      }
    },
    "assessmentHeuristics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unresolvedAcceptedSuggestionCount": {
          "type": "number",
          "minimum": 0
        },
        "unresolvedAcceptedSuggestionRate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "noChangesAfterEditFailureCount": {
          "type": "number",
          "minimum": 0
        },
        "recoverableToolErrorCount": {
          "type": "number",
          "minimum": 0
        },
        "touchedFilesPerResolvedFinding": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "components", "boundary", "visual", "responsiveness", "notes"],
      "properties": {
        "structure": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "components": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "boundary": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "visual": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "responsiveness": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "touchedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "heuristics": {
          "$ref": "#/$defs/assessmentHeuristics"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "surfaceId", "sessionId", "attemptNumber", "status", "findingCodes", "rationale", "reviewedAt"],
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "attemptNumber": {
          "type": "number",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": ["accepted", "rejected"]
        },
        "findingCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "recurringCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "number",
          "minimum": 2
        }
      }
    },
    "recurringRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count", "priority", "category", "actionType"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "number",
          "minimum": 2
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "actionType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sessionHeuristics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latestAttempt", "repeatedFindingCarryoverCount", "rerunsToAcceptableOutcome"],
      "properties": {
        "latestAttempt": {
          "$ref": "#/$defs/assessmentHeuristics"
        },
        "repeatedFindingCarryoverCount": {
          "type": "number",
          "minimum": 0
        },
        "rerunsToAcceptableOutcome": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "previewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagePath", "metadataPath", "url", "finalUrl", "capturedAt"],
      "properties": {
        "imagePath": {
          "type": "string",
          "minLength": 1
        },
        "metadataPath": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "finalUrl": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "waitFor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
