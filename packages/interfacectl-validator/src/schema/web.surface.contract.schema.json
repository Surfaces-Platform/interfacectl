{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.surfaces.local/web.surface.contract.schema.json",
  "title": "Web Surface Contract Schema",
  "description": "Built-in contract type schema for the web surface runtime. Not application-specific.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "version",
    "surfaces",
    "sections",
    "constraints",
    "color"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "x_extracted": {
      "type": "object",
      "description": "Phase 0: fields extracted from app code; not used by validator semantics.",
      "additionalProperties": true,
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hasShell": {
          "type": "boolean"
        },
        "designSystemComponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "authAware": {
          "type": "boolean"
        },
        "iconSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "shell": {
      "$ref": "#/$defs/shell"
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "type",
        "requiredSections",
        "allowedFonts",
        "layout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "web",
            "cli"
          ]
        },
        "requiredSections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "allowedFonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxContentWidth"
          ],
          "properties": {
            "maxContentWidth": {
              "type": "number",
              "minimum": 1
            },
            "requiredContainers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "pageFrame": {
              "$ref": "#/$defs/pageFrame"
            }
          }
        },
        "icons": {
          "$ref": "#/$defs/iconPolicy"
        },
        "phase0": {
          "type": "object",
          "description": "Phase 0.5: optional expectations for extracted reality (routes, auth, shell, design system).",
          "additionalProperties": false,
          "properties": {
            "authPosture": {
              "type": "string",
              "enum": [
                "public",
                "auth-aware",
                "auth-first"
              ]
            },
            "requiresShell": {
              "type": "boolean"
            },
            "expectsAuthRoutes": {
              "type": "boolean"
            },
            "expectsDesignSystem": {
              "type": "boolean"
            }
          }
        },
        "domain": {
          "type": "string",
          "description": "Informational: production domain (e.g. www.surfaces.systems)."
        },
        "owner": {
          "type": "string",
          "description": "Phase 2: informational owner (email or GitHub handle). No enforcement."
        },
        "mustNotEmit": {
          "type": "array",
          "description": "Elements or primitives the surface must not generate because the shell owns them. If omitted, consumers should default to shell.owns when present.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "shellOwnedPrimitiveAllowSources": {
          "type": "array",
          "description": "Repo-relative source patterns where shell-owned primitives are allowed to exist (for shell/layout ownership). Supports exact paths and * / ** wildcards.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion"
      ],
      "properties": {
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedDurationsMs",
            "allowedTimingFunctions"
          ],
          "properties": {
            "allowedDurationsMs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "allowedTimingFunctions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "pageFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerSelector",
        "containerMaxWidthPx",
        "paddingXpx"
      ],
      "properties": {
        "containerSelector": {
          "type": "string",
          "minLength": 1
        },
        "containerMaxWidthPx": {
          "type": "number",
          "minimum": 0
        },
        "containerMinWidthPx": {
          "type": "number",
          "minimum": 0
        },
        "paddingXpx": {
          "type": "number",
          "minimum": 0
        },
        "alignment": {
          "type": "string",
          "enum": [
            "center",
            "left"
          ],
          "default": "center"
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "strict",
            "warn"
          ],
          "default": "strict"
        }
      }
    },
    "iconPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allowedSources"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "allowedSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allowedValues"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owns": {
          "type": "array",
          "description": "Shell-owned layout primitives. Generators must not emit these inside surfaces.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contentSlot": {
          "type": "string",
          "description": "Identifier for the shell's content mount point (e.g. a frame or DOM id).",
          "minLength": 1
        }
      },
      "required": []
    }
  }
}
