{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.surfaces.local/web.surface.contract.schema.json",
  "title": "Web Surface Contract Schema",
  "description": "Built-in contract type schema for the web surface runtime. Not application-specific.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "version",
    "surfaces",
    "sections",
    "constraints",
    "color"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "tokens": {
      "$ref": "#/$defs/contractTokens"
    },
    "marketingProfiles": {
      "$ref": "#/$defs/marketingProfiles"
    },
    "x_extracted": {
      "type": "object",
      "description": "Phase 0: fields extracted from app code; not used by validator semantics.",
      "additionalProperties": true,
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hasShell": {
          "type": "boolean"
        },
        "designSystemComponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "authAware": {
          "type": "boolean"
        },
        "iconSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "shell": {
      "$ref": "#/$defs/shell"
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "type",
        "requiredSections",
        "allowedFonts",
        "layout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "web",
            "cli"
          ]
        },
        "requiredSections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "allowedFonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "marketingTypographyProfile": {
          "type": "string",
          "minLength": 1
        },
        "marketingTypographyPolicy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxContentWidth"
          ],
          "properties": {
            "maxContentWidth": {
              "type": "number",
              "minimum": 1
            },
            "requiredContainers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "pageFrame": {
              "$ref": "#/$defs/pageFrame"
            },
            "chromePolicy": {
              "$ref": "#/$defs/chromePolicy"
            },
            "landingPattern": {
              "$ref": "#/$defs/landingPattern"
            }
          }
        },
        "icons": {
          "$ref": "#/$defs/iconPolicy"
        },
        "flows": {
          "$ref": "#/$defs/flowPolicy"
        },
        "phase0": {
          "type": "object",
          "description": "Phase 0.5: optional expectations for extracted reality (routes, auth, shell, design system).",
          "additionalProperties": false,
          "properties": {
            "authPosture": {
              "type": "string",
              "enum": [
                "public",
                "auth-aware",
                "auth-first"
              ]
            },
            "requiresShell": {
              "type": "boolean"
            },
            "expectsAuthRoutes": {
              "type": "boolean"
            },
            "expectsDesignSystem": {
              "type": "boolean"
            }
          }
        },
        "domain": {
          "type": "string",
          "description": "Informational: production domain (e.g. www.surfaces.systems)."
        },
        "owner": {
          "type": "string",
          "description": "Phase 2: informational owner (email or GitHub handle). No enforcement."
        },
        "mustNotEmit": {
          "type": "array",
          "description": "Elements or primitives the surface must not generate because the shell owns them. If omitted, consumers should default to shell.owns when present.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "shellOwnedPrimitiveAllowSources": {
          "type": "array",
          "description": "Repo-relative source patterns where shell-owned primitives are allowed to exist (for shell/layout ownership). Supports exact paths and * / ** wildcards.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion"
      ],
      "properties": {
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedDurationsMs",
            "allowedTimingFunctions"
          ],
          "properties": {
            "allowedDurationsMs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "allowedTimingFunctions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "pageFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerSelector",
        "containerMaxWidthPx",
        "paddingXpx"
      ],
      "properties": {
        "containerSelector": {
          "type": "string",
          "minLength": 1
        },
        "containerMaxWidthPx": {
          "type": "number",
          "minimum": 0
        },
        "containerMinWidthPx": {
          "type": "number",
          "minimum": 0
        },
        "paddingXpx": {
          "type": "number",
          "minimum": 0
        },
        "alignment": {
          "type": "string",
          "enum": [
            "center",
            "left"
          ],
          "default": "center"
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "strict",
            "warn"
          ],
          "default": "strict"
        }
      }
    },
    "chromePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "targets",
        "maxBorderRadiusPx",
        "allowOuterShadow",
        "allowInsetShadow"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "page-container",
              "top-level-section",
              "layout-container"
            ]
          },
          "uniqueItems": true
        },
        "maxBorderRadiusPx": {
          "type": "number",
          "minimum": 0
        },
        "allowOuterShadow": {
          "type": "boolean"
        },
        "allowInsetShadow": {
          "type": "boolean"
        }
      }
    },
    "iconPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allowedSources"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "allowedSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "tokenPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allowedTokens"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "allowedTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tokenMetadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tokenMetadata"
          }
        }
      }
    },
    "tokenMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "normalizedValue",
        "attributes",
        "aliases"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "normalizedValue": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "contractTokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typography": {
          "$ref": "#/$defs/tokenPolicy"
        },
        "layout": {
          "$ref": "#/$defs/tokenPolicy"
        },
        "motion": {
          "$ref": "#/$defs/tokenPolicy"
        }
      }
    },
    "marketingProfiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketingLayoutProfile"
          }
        },
        "typography": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketingTypographyProfile"
          }
        }
      }
    },
    "marketingLayoutProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heroContainerMode",
        "heroVisualPlacement",
        "sectionDividerMode",
        "sectionSpacingProfile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "heroContainerMode": {
          "type": "string",
          "enum": [
            "open-flow",
            "framed"
          ]
        },
        "heroVisualPlacement": {
          "type": "string",
          "enum": [
            "inline-end",
            "inline-start",
            "stacked",
            "none"
          ]
        },
        "sectionDividerMode": {
          "type": "string",
          "enum": [
            "none",
            "border-top"
          ]
        },
        "sectionSpacingProfile": {
          "type": "string",
          "enum": [
            "compact",
            "roomy"
          ]
        }
      }
    },
    "marketingTypographyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/marketingTypographyRoleProfile"
          }
        }
      }
    },
    "marketingTypographyRoleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "allowedTokens"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "heroEyebrow",
            "heroTitle",
            "heroBody",
            "sectionTitle",
            "body"
          ]
        },
        "allowedTokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "landingPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "requireTopLevelSections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "sectionOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "pageBackgroundMode": {
          "type": "string",
          "enum": [
            "solid",
            "custom"
          ]
        },
        "marketingLayoutProfile": {
          "type": "string",
          "minLength": 1
        },
        "marketingLayoutPolicy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        }
      }
    },
    "flowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "requirements"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowRequirement"
          },
          "uniqueItems": true
        }
      }
    },
    "flowRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowId"
      ],
      "properties": {
        "flowId": {
          "type": "string",
          "minLength": 1
        },
        "minSteps": {
          "type": "integer",
          "minimum": 1
        },
        "requiredSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requiredTransitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowTransition"
          },
          "uniqueItems": true
        },
        "terminalSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "flowTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "allowedValues"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ]
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owns": {
          "type": "array",
          "description": "Shell-owned layout primitives. Generators must not emit these inside surfaces.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contentSlot": {
          "type": "string",
          "description": "Identifier for the shell's content mount point (e.g. a frame or DOM id).",
          "minLength": 1
        }
      },
      "required": []
    }
  }
}
